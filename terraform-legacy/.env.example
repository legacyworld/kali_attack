# Azure 認証（サービスプリンシパル使用の場合）
# export ARM_CLIENT_ID="..."
# export ARM_CLIENT_SECRET="..."
# export ARM_TENANT_ID="..."
# export ARM_SUBSCRIPTION_ID="..."

# Terraform 変数
export TF_VAR_windows_admin_password="P@ssw0rd1234!"
export TF_VAR_ad_safe_mode_password="Dsrm@P@ssw0rd!"
export TF_VAR_svc_account_password="P@ssw0rd!"
export TF_VAR_ssh_public_key="$(cat ~/.ssh/id_rsa.pub)"

# Step 1: 空のまま apply してストレージアカウントを作成
# Step 2: OPNsense VHD アップロード後に以下を設定して再 apply
# export TF_VAR_opnsense_vhd_uri="https://<ストレージアカウント名>.blob.core.windows.net/vhd/opnsense.vhd"

# ラボ終了日（空のままにすると apply 時から 7 日後が自動設定される）
# export TF_VAR_keep_until="2026-10-07"
